{
  "compilerOptions": {
    /* —— 输出目标 —— */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    /* —— 输入与互操作 —— */
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* —— 严格性 —— */
    "strict": true,
    /* vibe UI 层逐字移植自示例,保留原始未用变量/参数;关闭这两项避免大量噪声 */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* 类型-only 导入必须用 `import type`(配合 isolatedModules,打包器擦除更干净) */
    "verbatimModuleSyntax": true,

    /* —— React JSX —— */
    "jsx": "react-jsx",

    /* —— Vite 由打包器消费类型，自身不 emit —— */
    "noEmit": true,

    /* —— 路径别名 ——
       约定：
         @shared/*    —— 框架无关纯工具
         @domain/*    —— 领域模型与端口
         @core/*      —— 应用内核 / 插件 / 服务
         @providers/* —— 数据源适配器
         @/*          —— UI 层（src/ui/*），React 实现
       说明：TS 6+ 起，paths 可不依赖 baseUrl，直接以 tsconfig 所在目录为锚点。 */
    "paths": {
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"],
      "@domain": ["./src/domain/index.ts"],
      "@domain/*": ["./src/domain/*"],
      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],
      "@providers": ["./src/providers/index.ts"],
      "@providers/*": ["./src/providers/*"],
      "@/*": ["./src/ui/*"],
      "@wailsjs/*": ["./wailsjs/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test-setup.ts", "vite.config.ts"]
}
