{
  "compilerOptions": {
    /* —— 输出目标 —— */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    /* dougong 要求 ES2024 运行时(Promise.withResolvers)+ 显式资源管理声明 */
    "lib": ["DOM", "DOM.Iterable", "ES2024", "ESNext.Disposable"],

    /* —— 输入与互操作 —— */
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* —— 严格性 —— */
    "strict": true,
    /* 曾因「移植层保留原始未用变量」关闭;那批噪声早已不存在(重开后仅剩 18 处
       automatic-JSX 下多余的 `import React`,已删),所以两项都收回来当门禁用 */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* 类型-only 导入必须用 `import type`(配合 isolatedModules,打包器擦除更干净) */
    "verbatimModuleSyntax": true,

    /* —— React JSX —— */
    "jsx": "react-jsx",

    /* —— Vite 由打包器消费类型，自身不 emit —— */
    "noEmit": true,

    /* —— 路径别名 ——
       约定：
         @shared/*    —— 框架无关纯工具
         @domain/*    —— 领域模型与端口
         @core/*      —— 应用内核 / 插件 / 服务
         @contexts/*  —— 限界上下文与稳定跨上下文契约
         @providers/* —— 数据源适配器
         @/*          —— UI 层（src/ui/*），React 实现
       说明：TS 6+ 起，paths 可不依赖 baseUrl，直接以 tsconfig 所在目录为锚点。 */
    "paths": {
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"],
      "@domain": ["./src/domain/index.ts"],
      "@domain/*": ["./src/domain/*"],
      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@providers": ["./src/providers/index.ts"],
      "@providers/*": ["./src/providers/*"],
      "@/*": ["./src/ui/*"],
      "@bindings/*": ["./bindings/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "bindings/**/*.ts",
    "bindings/**/*.d.ts",
    "test-setup.ts",
    "vite.config.ts"
  ]
}
