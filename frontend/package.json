{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:dev": "vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:layers": "node scripts/check-layers.mjs",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn knip && yarn check:layers",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "src/**/*.{js,json,css,html}": "prettier --write",
    "*.{json,js,mjs,cjs,ts}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@wailsio/runtime": "3.0.0-beta.22",
    "clsx": "^2.1.1",
    "dougong": "0.5.0",
    "i18next": "^26.4.2",
    "ky": "^2.1.0",
    "motion": "^13.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "oxc-parser": "^0.150.0",
    "oxc-resolver": "^11.24.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
