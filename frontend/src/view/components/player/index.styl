.player
  height 80px
  width auto
  min-width 620px
  background-color white
  user-select none

  .player-wrapper
    height 100%
    width 100%
    display flex
    flex-direction row
    justify-content space-between

    .left-controls-wrapper
      background-color chartreuse
      padding 3px
      width 30%
      display flex
      flex-direction column
      justify-content center

      .left-controls
        margin-left 20px
        display flex
        flex-direction row

        .left-controls_thumbnail
          width 60px
          height 60px
          background-color black
          display flex
          text-align center
          border-radius 100%

          img
            max-width 40px
            max-height 40px
            margin auto

        .left-controls_meta
          display flex
          flex-direction column
          justify-content center
          margin-left 5px

          .left-controls_meta-title
            font-size 17px

          .left-controls_meta-artists
            font-size 15px
            opacity 0.6

    .middle-controls-wrapper
      width 40%
      background-color pink
      padding 3px

      .middle-controls
        width 100%
        display flex
        flex-direction column

        .middle-controls_progress-slider
          width 100%

          .middle-controls_progress-slider-time
          .middle-controls_progress-slider-time-left
          .middle-controls_progress-slider-time-right
            color red

        .middle-controls_actions
          display flex
          flex-direction row
          justify-content space-around

    .right-controls-wrapper
      background-color burlywood
      padding 3px
      width 30%
