.player
  height 72px
  width auto
  min-width 620px
  background-color aqua
  .player-wrapper
    height 100%
    width 100%
    display flex
    flex-direction row
    justify-content space-between
    .left-controls-wrapper
      background-color chartreuse
      padding 3px
      width 30%
      .left-controls
        display flex
        flex-direction row
        .left-controls_meta
          display flex
          flex-direction column
          justify-content center
          margin-left 5px
          .left-controls_meta-title
            font-size 17px
          .left-controls_meta-artists
            font-size 15px
            opacity 0.6

    .middle-controls-wrapper
      width 40%
      background-color pink
      padding 3px
      .middle-controls
        width 100%
        display flex
        flex-direction column
        .middle-controls_actions_slider
          width 100%

    .right-controls-wrapper
      background-color burlywood
      padding 3px
      width 30%